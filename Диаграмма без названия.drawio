        <mxCell id="vgQaP42fv_d9BGE7a3tM-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;caret-color: rgb(237, 237, 237); color: rgb(33, 33, 33);&quot;&gt;PK - a unique identifier for a specific record within a table&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;caret-color: rgb(237, 237, 237); color: rgb(33, 33, 33);&quot;&gt;FK - a field that links to the primary key of another table to establish a relationship&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;caret-color: rgb(237, 237, 237); color: rgb(33, 33, 33);&quot;&gt;1 to N means that the relationship is one-to-many&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;caret-color: rgb(237, 237, 237); color: rgb(33, 33, 33);&quot;&gt;1 to 1mmeanst that the relationship is one-to-one&lt;/span&gt;&lt;/div&gt;" vertex="1">
